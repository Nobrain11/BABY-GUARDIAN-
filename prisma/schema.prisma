generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  id                        String   @id @default(cuid())
  telegramId                String   @unique
  title                     String?

  welcomeEnabled            Boolean  @default(true)
  antiSpamEnabled           Boolean  @default(true)
  antiLinksEnabled          Boolean  @default(true)
  antiRaidEnabled           Boolean  @default(true)

  lockdown                  Boolean  @default(false)

  maxMessages               Int      @default(6)
  floodWindowSec            Int      @default(5)
  maxWarnings               Int      @default(3)

  welcomeMessage            String   @default("🍼💚 Welcome to BABY! Please read /rules.")

  rules                     String   @default("BABY COMMUNITY RULES: No scams. No spam. No phishing links. No impersonation. Respect everyone.")

  blockedWords              String   @default("free eth,double your,send eth,send crypto,claim reward,airdrop now,connect wallet")

  buyBotEnabled             Boolean  @default(false)
  buyBotMinEth              Decimal  @default(0.01) @db.Decimal(30, 18)
  buyBotWhaleEth            Decimal  @default(1) @db.Decimal(30, 18)
  buyBotShowWallet          Boolean  @default(true)
  buyBotShowUsd             Boolean  @default(true)
  buyBotShowTx              Boolean  @default(true)
  buyBotShowAmount          Boolean  @default(true)
  buyBotEmoji               String   @default("🍼")
  buyBotChannel             String?

  walletVerificationEnabled Boolean  @default(false)

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  members                   Member[]
  warnings                  Warning[]
  logs                      AuditLog[]
  events                    GroupEvent[]
  buyAlerts                 BuyAlert[]
  walletVerifications       WalletVerification[]
}

model Member {
  id                  String   @id @default(cuid())
  groupId             String
  telegramId          String

  username            String?
  firstName           String?
  lastName            String?

  role                String   @default("member")

  warnings            Int      @default(0)
  xp                  Int      @default(0)
  messages            Int      @default(0)

  joinedAt            DateTime @default(now())
  lastMessageAt       DateTime?

  group               Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  warningsLog         Warning[]
  walletVerifications WalletVerification[]

  @@unique([groupId, telegramId])
  @@index([groupId])
  @@index([telegramId])
}

model Warning {
  id          String   @id @default(cuid())
  groupId     String
  memberId    String

  reason      String
  moderatorId String?

  createdAt   DateTime @default(now())

  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([memberId])
}

model AuditLog {
  id        String   @id @default(cuid())
  groupId   String

  actorId   String?
  targetId  String?

  action    String
  details   String?

  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model GroupEvent {
  id          String   @id @default(cuid())
  groupId     String

  type        String
  telegramId  String?
  payload     String?

  createdAt   DateTime @default(now())

  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model BuyAlert {
  id                String   @id @default(cuid())

  groupId           String
  txHash            String
  buyer             String

  amountEth         Decimal  @db.Decimal(30, 18)
  amountUsd         Decimal? @db.Decimal(30, 18)
  tokenAmount       Decimal? @db.Decimal(50, 18)

  blockNumber       BigInt?
  timestamp         DateTime @default(now())

  telegramMessageId Int?

  isWhale            Boolean  @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  group              Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, txHash])
  @@index([groupId, createdAt])
  @@index([buyer])
  @@index([txHash])
}

model WalletVerification {
  id            String   @id @default(cuid())

  groupId       String
  memberId      String
  telegramId    String

  walletAddress String
  chainId       Int      @default(4663)

  message       String?
  signature     String?

  status        String   @default("pending")

  verifiedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([memberId])
  @@index([telegramId])
  @@index([walletAddress])
  @@unique([groupId, walletAddress])
}
