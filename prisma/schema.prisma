generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  id                String   @id @default(cuid())
  telegramId        String   @unique
  title             String?

  welcomeEnabled    Boolean  @default(true)
  antiSpamEnabled   Boolean  @default(true)
  antiLinksEnabled  Boolean  @default(true)
  antiRaidEnabled   Boolean  @default(true)

  lockdown          Boolean  @default(false)

  maxMessages       Int      @default(6)
  floodWindowSec    Int      @default(5)
  maxWarnings       Int      @default(3)

  welcomeMessage    String   @default("🍼💚 Welcome to BABY! Please read /rules.")
  rules             String   @default("🍼💚 BABY COMMUNITY RULES\n\n1. No scams.\n2. No spam.\n3. No phishing links.\n4. No impersonation.\n5. Respect everyone.")
  blockedWords      String   @default("free eth,double your,send eth,send crypto,claim reward,airdrop now,connect wallet")

  // Buy Bot
  buyBotEnabled     Boolean  @default(false)
  buyBotMinEth      Float    @default(0.05)
  buyBotWhaleEth    Float    @default(1.0)
  buyBotShowWallet  Boolean  @default(true)
  buyBotShowUsd     Boolean  @default(true)
  buyBotShowTx      Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members           Member[]
  warnings          Warning[]
  logs              AuditLog[]
  events            GroupEvent[]
  buyAlerts         BuyAlert[]

  @@index([createdAt])
}

model Member {
  id             String    @id @default(cuid())

  groupId        String
  telegramId     String

  username       String?
  firstName      String?
  lastName       String?

  role           String    @default("member")

  warnings       Int       @default(0)
  xp             Int       @default(0)
  messages       Int       @default(0)

  joinedAt       DateTime  @default(now())
  lastMessageAt  DateTime?

  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  warningsLog    Warning[]

  @@unique([groupId, telegramId])
  @@index([groupId])
  @@index([telegramId])
}

model Warning {
  id           String   @id @default(cuid())

  groupId      String
  memberId     String

  reason       String
  moderatorId  String?

  createdAt    DateTime @default(now())

  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([memberId])
}

model AuditLog {
  id          String   @id @default(cuid())

  groupId     String

  actorId     String?
  targetId    String?

  action      String
  details     String?

  createdAt   DateTime @default(now())

  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model GroupEvent {
  id          String   @id @default(cuid())

  groupId     String

  type        String
  telegramId  String?
  payload     String?

  createdAt   DateTime @default(now())

  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model BuyAlert {
  id               String   @id @default(cuid())

  groupId          String

  // Blockchain transaction
  txHash           String
  buyer            String
  tokenAddress     String

  // Amount paid in native Robinhood Chain ETH
  nativeAmount     Float

  // Token amount received, when available
  tokenAmount      String?

  // Optional market information
  usdValue         Float?
  tokenSymbol      String?
  tokenName        String?

  // Transaction metadata
  blockNumber      BigInt?
  timestamp        DateTime @default(now())

  // Telegram message used for updating/editing alerts
  telegramMessageId Int?

  // Whale classification
  isWhale          Boolean  @default(false)

  group             Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, txHash])
  @@index([groupId, timestamp])
  @@index([tokenAddress])
  @@index([buyer])
  @@index([txHash])
}
